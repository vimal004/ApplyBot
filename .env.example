# ApplyBot Environment Configuration Example

# 1. Gmail SMTP Setup (For auto-emailing recruiters)
SENDER_EMAIL=your_email@gmail.com
# Generate an App Password from your Google Account settings:
# Manage Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=your_gmail_app_password

# 2. Groq LLM API Key (For human-tone question answering & ATS resume tailoring)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# 3. Application Preferences
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 4. Telegram Auto-Ingestion (Get credentials from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_GROUP=SDE Premium Referrals 2.0
