# ApplyBot Environment Configuration Example

# 1. Gmail SMTP Setup (For auto-emailing recruiters)
SENDER_EMAIL=your_email@gmail.com
# Generate an App Password from your Google Account settings:
# Manage Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=your_gmail_app_password

# 2. Groq LLM API Key (For human-tone question answering & ATS resume tailoring)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# 3. Application Preferences
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# 4. Telegram Auto-Ingestion
# RECOMMENDED: Use Bot API (permanent, zero-maintenance)
# Create a bot via @BotFather, turn off Group Privacy, add to your group
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_GROUP=-1002715063688

# LEGACY FALLBACK: Client API (requires periodic session regeneration)
# Get credentials from https://my.telegram.org
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_SESSION_STRING=generated_by_telegram_login_py
