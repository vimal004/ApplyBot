#!/bin/bash
cd "$(dirname "$0")"

echo "⚡ Ensuring ApplyBot background service is loaded and active..."
mkdir -p ~/Library/LaunchAgents
mkdir -p ~/.config/com.vimal.applybot

ln -sf ~/.config/com.vimal.applybot/backend.log "$(pwd)/backend.log"

cp "$(pwd)/com.vimal.applybot.backend.plist" ~/Library/LaunchAgents/com.vimal.applybot.backend.plist
launchctl load -w ~/Library/LaunchAgents/com.vimal.applybot.backend.plist 2>/dev/null || true

sleep 2
if curl -s http://localhost:5050/api/telegram/status > /dev/null; then
    echo "============================================================"
    echo "✅ ApplyBot 24/7 Background Daemon is RUNNING!"
    echo "⚡ Dashboard URL: http://localhost:5050"
    echo "📋 Logs File:     $(pwd)/backend.log"
    echo "============================================================"
    echo "This service runs automatically in the background even if"
    echo "you close your IDE or restart your Mac."
    echo ""
    echo "Commands:"
    echo "  - View live logs:  tail -f backend.log"
    echo "  - Stop daemon:     launchctl unload ~/Library/LaunchAgents/com.vimal.applybot.backend.plist"
    echo "  - Start daemon:    launchctl load -w ~/Library/LaunchAgents/com.vimal.applybot.backend.plist"
else
    echo "❌ ApplyBot service initializing... check 'tail -f backend.log' for live status."
fi

